# =============================================================
# Rent Worx — environment variables
# Copy to .env.local (dev) / set in Vercel (prod). None are required for
# Phase 1 (the site runs on seed data). Fill these for Phase 2 integrations.
# =============================================================

# ---- Public site URL (canonical, sitemap, robots, OG tags) ----
# Set to the production domain once live, e.g. https://www.rentworx.co.nz
NEXT_PUBLIC_SITE_URL="https://www.rentworx.co.nz"

# ---- PostgreSQL cache of MRI Palace listings (Phase 2) ----
# Vercel Postgres / Neon / Supabase connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rentworx?schema=public"

# ---- MRI Palace API (single source of truth) ----
PALACE_API_BASE=""
PALACE_API_KEY=""

# ---- Sync pipeline auth ----
# Shared secret required (header x-sync-secret, or ?secret=) to call
# POST /api/sync/palace from a cron job or MRI Palace webhook.
SYNC_SECRET=""

# ---- Trade Me API (fallback syndication, filtered by agency id) ----
TRADEME_API_BASE="https://api.trademe.co.nz/v1"
TRADEME_CONSUMER_KEY=""
TRADEME_CONSUMER_SECRET=""
TRADEME_OAUTH_TOKEN=""
TRADEME_OAUTH_TOKEN_SECRET=""
TRADEME_AGENCY_ID=""

# ---- Tenancy.co.nz redirect (client-visible; NO tenant PII stored locally) ----
NEXT_PUBLIC_TENANCY_REDIRECT_BASE="https://app.tenancy.co.nz/redirect"
NEXT_PUBLIC_TENANCY_AGENCY="rentworx"
